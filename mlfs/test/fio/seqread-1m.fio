# 1 MiB sequential read — the throughput job. Acceptance targets
# (docs/operations.md): >= 200 MB/s warm; cold ≈ file_size / S3 GET bandwidth.
# Run via test/fio/run-fio.sh (which sets DIRECTORY to a live mlfs mount).
[global]
ioengine=libaio
direct=0
rw=read
bs=1m
size=1g
runtime=30
time_based=1
group_reporting=1

[seqread-1m]
numjobs=1
