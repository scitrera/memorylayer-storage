# SPDX-License-Identifier: AGPL-3.0-only
# Build context: repository root (all workspace modules are needed).
FROM --platform=$BUILDPLATFORM golang:1.26.8 AS build
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build cd /src/mlfs && go build -trimpath -ldflags="-s -w" -o /out/mlfs ./cmd/mlfs
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build cd /src/mlfs && go build -trimpath -ldflags="-s -w" -o /out/mlfs-admin ./cmd/mlfs-admin
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build cd /src/mlfs && go build -trimpath -ldflags="-s -w" -o /out/mlfs-bench ./cmd/mlfs-bench

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fuse3 util-linux \
    && rm -rf /var/lib/apt/lists/*
ARG VERSION
LABEL org.opencontainers.image.source="https://github.com/scitrera/memorylayer-storage" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="$VERSION"
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/memorylayer-storage/
COPY LICENSES /usr/share/doc/memorylayer-storage/LICENSES
COPY --from=build /out/mlfs /usr/local/bin/mlfs
COPY --from=build /out/mlfs-admin /usr/local/bin/mlfs-admin
COPY --from=build /out/mlfs-bench /usr/local/bin/mlfs-bench
ENTRYPOINT ["/usr/local/bin/mlfs"]
